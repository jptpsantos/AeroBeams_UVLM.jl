+# PROTOTYPE: tip loss function accompanied by a spanwise shift of the aerodynamic center
+struct TipLossWithShift{W,D}
+    w::W
+    d::D
+end
+(t::TipLossWithShift)(s) = t.w(s)
+struct VarpiXac{F,G} <: Function
+    ϖ::F
+    Δ::G
+end
+(v::VarpiXac)(U,ζ) = v.ϖ(U,ζ)
+xshift(ϖ,U,ζ) = 0.0
+xshift(v::VarpiXac,U,ζ) = v.Δ(U,ζ)
 
